# Copy to .env. Do not put a KX licence key in git.
MARKETSTREAM_HOST=127.0.0.1
MARKETSTREAM_PORT=8000
MARKETSTREAM_SEED=42
MARKETSTREAM_SPEED=4
MARKETSTREAM_WARMUP_PULSES=240
MARKETSTREAM_STARTING_CASH=1000000
MARKETSTREAM_Q_ENABLED=true
MARKETSTREAM_Q_HOST=127.0.0.1
MARKETSTREAM_Q_PORT=5001
# Optional. Leave empty for a local workstation with no auth.
MARKETSTREAM_API_TOKEN=
# Base64 Community Edition key, only if you install KDB-X. Never commit the real value.
# KDB_LICENSE_B64=
